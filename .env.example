POSTGRES_DB=mt5_data
POSTGRES_USER=mt5_app
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://mt5_app:change-this-local-password@localhost:5432/mt5_data
APP_ENV=development
# Required to unlock the dashboard environment-management section.
# Generate a strong local value and never commit it.
DASHBOARD_ADMIN_TOKEN=

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_CONNECT_TIMEOUT_MS=60000
MT5_DASHBOARD_DIRECT=false
MT5_ENABLED=false
MT5_LEGACY_ORDER_PATH_ENABLED=false
MT5_AUTO_TRADING_ENABLED=false
# API container execution is independent; keep false when Windows Dashboard owns MT5.
API_MT5_AUTO_TRADING_ENABLED=false
MT5_DEMO_ENABLED=false
MT5_DEMO_MAX_TRADE_VOLUME=0.01
MT5_DEMO_MAX_TRADES_PER_SESSION=3
MT5_DEMO_MAX_DAILY_LOSS=10
MT5_DEMO_REQUIRE_MANUAL_CONFIRMATION=true
MT5_DEMO_AUTO_STOP_ON_ERROR=true
MT5_XAUUSD_SYMBOL=XAUUSD
DATA_SYMBOLS=XAUUSD
DATA_TIMEFRAMES=M5
MT5_HISTORY_BARS=30000
LOG_LEVEL=INFO
LOG_FILE=logs/data_collector.log
# Operational retention policy; cleanup jobs must target only these managed stores.
ORDER_AUDIT_RETENTION_DAYS=90
BROKER_RESPONSE_RETENTION_DAYS=90
LOG_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=90
OBS_ALERT_HTTP_5XX_THRESHOLD=5
OBS_ALERT_ORDER_REJECTIONS_THRESHOLD=1
OBS_ALERT_GATEWAY_TIMEOUTS_THRESHOLD=1
OBS_ALERT_STALE_SIGNAL_THRESHOLD=1
OBS_ALERT_DUPLICATE_IDEMPOTENCY_THRESHOLD=1
OBS_ALERT_DATA_GAPS_THRESHOLD=1
# Optional network-level protection for the internal Prometheus endpoint.
OBS_METRICS_TOKEN=
# Optional per-symbol/timeframe candle freshness thresholds, in seconds.
OBS_CANDLE_MAX_AGE_SECONDS={"XAUUSD:M5":600}
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-grafana-password

MODEL_OUTPUT_DIR=models

# Stage E: no MT5 order is sent; would-be orders and later outcomes are appended here.
SHADOW_LEDGER_PATH=data/shadow_orders.jsonl

# HTTP API and MT5 execution gateway. Keep API_AUTH_TOKEN secret outside source control.
API_AUTH_TOKEN=
# Prefer short-lived HMAC bearer tokens for service-to-service calls.
API_AUTH_JWT_SECRET=
API_AUTH_JWT_ISSUER=smart-mt5-api
API_AUTH_TOKEN_TTL_SECONDS=300
# Production must configure credentials for protected roles; blank values fail closed.
API_AUTH_READ_TOKEN=
API_AUTH_ORDER_REVIEW_TOKEN=
API_AUTH_EXECUTION_TOKEN=
API_AUTH_OPERATOR_TOKEN=
API_AUTH_MODEL_TOKEN=
MT5_LIVE_SYMBOLS=XAUUSD_l
# Must match the EA input InpMagicNumber (default: 26090901).
MT5_LIVE_MAGIC=26090901
MT5_MAX_POSITION_VOLUME=0.02
MT5_MAX_DAILY_LOSS=10
MT5_DEMO_MAX_DAILY_LOSS=10
MT5_AUTO_TRADING_ENABLED=false
ZMQ_EXECUTION_ENDPOINT=tcp://127.0.0.1:5555
ZMQ_EXECUTION_TIMEOUT_MS=1000
