    {
      "name": "heartbeat",
      "request": {
        "schema_version": "1.0",
        "message_id": "case-heartbeat-001",
        "message_type": "heartbeat",
        "sent_at": "2026-09-17T00:00:00Z",
        "correlation_id": "corr-heartbeat-001",
        "source": "python",
        "payload": {
          "status": "alive"
        }
      },
      "expected": {
        "status": "accepted",
        "accepted": true,
        "requires_reconciliation": false
      },
      "safety_invariant": "heartbeat is informational and never executes an order"
    },
