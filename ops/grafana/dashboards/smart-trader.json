{
  "annotations": {
    "list": []
  },
  "editable": false,
  "panels": [
    {
      "title": "API Availability",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(up{job=\"smart-trader-api\"})", "legendFormat": "up"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "HTTP 5xx Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(rate(http_5xx_total[5m]))", "legendFormat": "5xx/s"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "MT5 Connectivity",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{"expr": "max(mt5_health_configured) == 0 or min(mt5_connected)", "legendFormat": "connected"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "Circuit Breaker",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{"expr": "max(circuit_breaker_configured) == 0 or max(circuit_breaker_tripped)", "legendFormat": "tripped"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "title": "Candle Freshness",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max by (symbol, timeframe) (candle_data_age_seconds)",
          "legendFormat": "{{symbol}} / {{timeframe}} age"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
    },
    {
      "title": "Observability Sources & Configuration",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "observability_source_available",
          "legendFormat": "{{instance}} / {{source}}"
        },
        {
          "expr": "max(candle_freshness_configured)",
          "legendFormat": "freshness configured"
        },
        {
          "expr": "max by (symbol, timeframe) (candle_data_available)",
          "legendFormat": "{{symbol}} / {{timeframe}} data available"
        }
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
    },
    {
      "title": "Unresolved Orders",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{"expr": "max(unknown_orders_count)", "legendFormat": "unknown orders"}],
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
    }
  ],
  "schemaVersion": 39,
  "title": "Smart Trader Operational Overview",
  "uid": "smart-trader-operational",
  "version": 1
}
